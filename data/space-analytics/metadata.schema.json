{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morris Library isolated space metadata",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_version",
    "revision",
    "sources",
    "features",
    "logical_spaces",
    "proposed_relationships",
    "approved_relationships",
    "membership_proposals",
    "approvals",
    "history",
    "display_links"
  ],
  "properties": {
    "schema_version": {
      "const": "morris-space-metadata/v1"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "floor_id",
          "source_dataset",
          "source_sha256"
        ],
        "properties": {
          "floor_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "source_dataset": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "logical_spaces": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "proposed_relationships": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approved_relationships": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "membership_proposals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "display_links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": [
        "feature_id",
        "floor_id",
        "source_dataset",
        "source_export_id",
        "dataset_version",
        "source_sha256",
        "footprint_hash",
        "original_name",
        "geometry_role",
        "proposed_geometry_role",
        "space_category",
        "space_subcategory",
        "secondary_tags",
        "logical_space_id",
        "component_of",
        "parent_space_id",
        "relationship_status",
        "classification_status",
        "verification_status",
        "verified_by",
        "last_verified",
        "assignable",
        "include_in_room_count",
        "include_in_area_total"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "floor_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "source_dataset": {
          "type": "string"
        },
        "source_export_id": {
          "type": [
            "object",
            "null"
          ]
        },
        "dataset_version": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "footprint_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "geometry_role": {
          "enum": [
            "room_boundary",
            "functional_zone",
            "nested_compartment",
            "service_fixture",
            "furniture_or_equipment",
            "structural_component",
            "stair_component",
            "elevator_component",
            "circulation_zone",
            "floor_background",
            "unknown"
          ]
        },
        "proposed_geometry_role": {
          "enum": [
            "room_boundary",
            "functional_zone",
            "nested_compartment",
            "service_fixture",
            "furniture_or_equipment",
            "structural_component",
            "stair_component",
            "elevator_component",
            "circulation_zone",
            "floor_background",
            "unknown"
          ]
        },
        "space_category": {
          "enum": [
            "study_learning",
            "open_reading_study",
            "research_cultural_resources",
            "auditorium_events",
            "library_services",
            "offices_administration",
            "collections_bookshelves",
            "restroom_facilities",
            "circulation_vertical_access",
            "building_support",
            "structure_non_occupiable",
            "floor_background",
            "unclassified"
          ]
        },
        "proposed_space_category": {
          "enum": [
            "study_learning",
            "open_reading_study",
            "research_cultural_resources",
            "auditorium_events",
            "library_services",
            "offices_administration",
            "collections_bookshelves",
            "restroom_facilities",
            "circulation_vertical_access",
            "building_support",
            "structure_non_occupiable",
            "floor_background",
            "unclassified"
          ]
        },
        "space_subcategory": {
          "type": [
            "string",
            "null"
          ]
        },
        "secondary_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "logical_space_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "component_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_space_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "relationship_status": {
          "enum": [
            "unreviewed",
            "approved"
          ]
        },
        "classification_status": {
          "enum": [
            "unclassified",
            "proposed",
            "approved"
          ]
        },
        "verification_status": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "verified_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ]
        },
        "assignable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "include_in_room_count": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "include_in_area_total": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
